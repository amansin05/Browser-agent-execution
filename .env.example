# Copy this file to ".env" and fill in your keys.
# Get a free Groq key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Only needed for `scout_mcp_agent.py --extension` (Path B, live Chrome).
# Install the "Playwright MCP Bridge" extension, open its popup, copy the token here.
# Leaving it blank still works — you'll just approve each connection in the browser.
PLAYWRIGHT_MCP_EXTENSION_TOKEN=
